<?xml version="1.0"?>
<!--
  Livox Mid-360 (lidar + built-in IMU) for gz-sim 8.

  * Model origin / lidar_link origin = centre of the mounting face (bottom of the housing).
  * livox_frame (optical centre) is 47 mm above it; all sensors are posed relative to it.
  * IMU at (0.011, 0.02329, -0.04412) m in livox_frame (FAST-LIO extrinsic_T = -that).

  Include it with <include><uri>model://livox_mid360</uri></include> and attach a joint to
  livox_mid360::lidar_link. Topics (gz side): /livox/points, /livox/imu_raw.
-->
<sdf version="1.9">
  <model name="livox_mid360">
    <link name="lidar_link">
      <inertial>
        <pose>0 0 0.03 0 0 0</pose>
        <mass>0.265</mass>
        <inertia>
          <ixx>1.73e-4</ixx><iyy>1.73e-4</iyy><izz>1.40e-4</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="housing_collision">
        <pose>0 0 0.03 0 0 0</pose>
        <geometry><cylinder><radius>0.0325</radius><length>0.06</length></cylinder></geometry>
      </collision>
      <visual name="housing_visual">
        <pose>0 0 0.03 0 0 0</pose>
        <geometry><cylinder><radius>0.0325</radius><length>0.06</length></cylinder></geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse>
          <specular>0.3 0.3 0.3 1</specular>
        </material>
      </visual>

      <!-- Dense depth render, sampled along the Mid-360 pattern by the system below.
           1440 x 160 = 0.25 deg x 0.377 deg over 360 x -7.5..52.5 deg. -->
      <sensor name="livox_dense" type="gpu_lidar">
        <pose>0 0 0.047 0 0 0</pose>
        <topic>/livox/dense_scan</topic>
        <update_rate>10</update_rate>
        <always_on>true</always_on>
        <visualize>false</visualize>
        <lidar>
          <scan>
            <horizontal>
              <samples>1440</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159265359</min_angle>
              <max_angle>3.13722933188</max_angle>
            </horizontal>
            <vertical>
              <samples>160</samples>
              <resolution>1</resolution>
              <min_angle>-0.130899693899</min_angle>
              <max_angle>0.916297857297</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.1</min>
            <max>70.0</max>
            <resolution>0.001</resolution>
          </range>
        </lidar>
      </sensor>

      <!-- Built-in IMU (ICM40609-class noise). 0.047 - 0.04412 = 0.00288 -->
      <sensor name="livox_imu" type="imu">
        <pose>0.011 0.02329 0.00288 0 0 0</pose>
        <topic>/livox/imu_raw</topic>
        <update_rate>200</update_rate>
        <always_on>true</always_on>
        <imu>
          <angular_velocity>
            <x><noise type="gaussian"><mean>0</mean><stddev>6.6e-4</stddev></noise></x>
            <y><noise type="gaussian"><mean>0</mean><stddev>6.6e-4</stddev></noise></y>
            <z><noise type="gaussian"><mean>0</mean><stddev>6.6e-4</stddev></noise></z>
          </angular_velocity>
          <linear_acceleration>
            <x><noise type="gaussian"><mean>0</mean><stddev>0.01</stddev></noise></x>
            <y><noise type="gaussian"><mean>0</mean><stddev>0.01</stddev></noise></y>
            <z><noise type="gaussian"><mean>0</mean><stddev>0.01</stddev></noise></z>
          </linear_acceleration>
        </imu>
      </sensor>
    </link>

    <plugin filename="livox_mid360_sim_system" name="livox_mid360_sim::LivoxMid360">
      <frame_id>livox_frame</frame_id>
      <dense_topic>/livox/dense_scan</dense_topic>
      <points_topic>/livox/points</points_topic>
      <pattern_file>model://livox_mid360/scan_mode/mid360.csv</pattern_file>
      <point_rate>200000</point_rate>
      <frame_rate>10</frame_rate>
      <min_range>0.1</min_range>
      <max_range>70.0</max_range>
      <nominal_range>40.0</nominal_range>
      <range_noise_stddev>0.02</range_noise_stddev>
    </plugin>
  </model>
</sdf>
