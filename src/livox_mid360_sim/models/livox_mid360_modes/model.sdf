<?xml version="1.0"?>
<!--
  Livox Mid-360 (lidar + built-in IMU) for gz-sim 8.

  * Model origin / lidar_link origin = centre of the mounting face (bottom of the housing).
  * livox_frame (optical centre) is 47 mm above it; all sensors are posed relative to it.
  * IMU at (0.011, 0.02329, -0.04412) m in livox_frame (FAST-LIO extrinsic_T = -that).

  Sensor: approach 3, one plugin with three lidar modes (<mode> below, default sliced):
    snapshot  1 dense gpu_lidar image per frame        (gpu_lidar update_rate 10)
    sliced    <slices> images per frame, real skew     (update_rate 10 * slices = 50)
    raycast   CPU ray casting, no rendering            (gpu_lidar only marks the origin)
  If you change <mode>/<slices>, set the gpu_lidar update_rate to match. Needs the Sensors
  system (ogre2). Same frames/topics as model://livox_mid360.

  Include it with <include><uri>model://livox_mid360_modes</uri><name>livox_mid360</name></include>
  to keep the livox_mid360::lidar_link name, and attach a joint to it. Topics (gz side): /livox/points, /livox/imu_raw.
-->
<sdf version="1.9">
  <model name="livox_mid360_modes">
    <link name="lidar_link">
      <inertial>
        <pose>0 0 0.03 0 0 0</pose>
        <mass>0.265</mass>
        <inertia>
          <ixx>1.73e-4</ixx><iyy>1.73e-4</iyy><izz>1.40e-4</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="housing_collision">
        <pose>0 0 0.03 0 0 0</pose>
        <geometry><cylinder><radius>0.0325</radius><length>0.06</length></cylinder></geometry>
      </collision>
      <visual name="housing_visual">
        <pose>0 0 0.03 0 0 0</pose>
        <geometry><cylinder><radius>0.0325</radius><length>0.06</length></cylinder></geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse>
          <specular>0.3 0.3 0.3 1</specular>
        </material>
      </visual>

      <!-- Dense range image resampled by LivoxMid360Modes (sliced: 10 Hz * 5 slices). -->
      <sensor name="livox_dense_lidar" type="gpu_lidar">
        <pose>0 0 0.047 0 0 0</pose>
        <topic>/livox/dense_scan</topic>
        <update_rate>50</update_rate>
        <always_on>true</always_on>
        <visualize>false</visualize>
        <lidar>
          <scan>
            <horizontal>
              <samples>1440</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159265359</min_angle>
              <max_angle>3.14159265359</max_angle>
            </horizontal>
            <vertical>
              <samples>160</samples>
              <resolution>1</resolution>
              <min_angle>-0.130899693899</min_angle>
              <max_angle>0.916297857297</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.1</min>
            <max>70.0</max>
            <resolution>0.002</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.02</stddev>
          </noise>
        </lidar>
      </sensor>

      <!-- Built-in IMU (ICM40609-class noise). 0.047 - 0.04412 = 0.00288 -->
      <sensor name="livox_imu" type="imu">
        <pose>0.011 0.02329 0.00288 0 0 0</pose>
        <topic>/livox/imu_raw</topic>
        <update_rate>200</update_rate>
        <always_on>true</always_on>
        <imu>
          <angular_velocity>
            <x><noise type="gaussian"><mean>0</mean><stddev>6.6e-4</stddev></noise></x>
            <y><noise type="gaussian"><mean>0</mean><stddev>6.6e-4</stddev></noise></y>
            <z><noise type="gaussian"><mean>0</mean><stddev>6.6e-4</stddev></noise></z>
          </angular_velocity>
          <linear_acceleration>
            <x><noise type="gaussian"><mean>0</mean><stddev>0.01</stddev></noise></x>
            <y><noise type="gaussian"><mean>0</mean><stddev>0.01</stddev></noise></y>
            <z><noise type="gaussian"><mean>0</mean><stddev>0.01</stddev></noise></z>
          </linear_acceleration>
        </imu>
      </sensor>
    </link>

    <plugin filename="livox_mid360_modes_system" name="livox_mid360_sim::modes::LivoxMid360Modes">
      <input_topic>/livox/dense_scan</input_topic>
      <output_topic>/livox/points</output_topic>
      <frame_id>livox_frame</frame_id>
      <frame_rate>10</frame_rate>
      <points_per_second>200000</points_per_second>
      <min_range>0.1</min_range>
      <max_range>70.0</max_range>
      <pattern_file>model://livox_mid360/scan_mode/mid360.csv</pattern_file>
      <!-- snapshot | sliced | raycast, see src/modes/livox_mid360_modes_system.cpp -->
      <mode>sliced</mode>
      <slices>5</slices>
      <sensor_name>livox_dense_lidar</sensor_name>
      <range_noise>0.02</range_noise>
    </plugin>
  </model>
</sdf>
