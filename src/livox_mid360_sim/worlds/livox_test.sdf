<?xml version="1.0"?>
<!-- Test arena for the Livox Mid-360: walls, pillars, boxes, a ramp and an overhang
     so both the downward (-7 deg) and the steep upward (+52 deg) FOV see geometry. -->
<sdf version="1.9">
  <world name="livox_test">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <gravity>0 0 -9.81</gravity>
    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.75 0.8 0.85 1</background>
      <grid>false</grid>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.4 0.2 -0.9</direction>
    </light>

    <model name="ground">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>60 60</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>60 60</size></plane></geometry>
          <material><ambient>0.45 0.47 0.45 1</ambient><diffuse>0.45 0.47 0.45 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="arena">
      <static>true</static>
      <link name="walls">
        <collision name="north"><pose>0 10 1.5 0 0 0</pose><geometry><box><size>30 0.2 3</size></box></geometry></collision>
        <visual name="north_visual"><pose>0 10 1.5 0 0 0</pose><geometry><box><size>30 0.2 3</size></box></geometry>
          <material><ambient>0.8 0.78 0.7 1</ambient><diffuse>0.8 0.78 0.7 1</diffuse></material></visual>
        <collision name="south"><pose>0 -10 1.5 0 0 0</pose><geometry><box><size>30 0.2 3</size></box></geometry></collision>
        <visual name="south_visual"><pose>0 -10 1.5 0 0 0</pose><geometry><box><size>30 0.2 3</size></box></geometry>
          <material><ambient>0.8 0.78 0.7 1</ambient><diffuse>0.8 0.78 0.7 1</diffuse></material></visual>
        <collision name="east"><pose>15 0 1.5 0 0 0</pose><geometry><box><size>0.2 20 3</size></box></geometry></collision>
        <visual name="east_visual"><pose>15 0 1.5 0 0 0</pose><geometry><box><size>0.2 20 3</size></box></geometry>
          <material><ambient>0.7 0.75 0.8 1</ambient><diffuse>0.7 0.75 0.8 1</diffuse></material></visual>
        <collision name="west"><pose>-15 0 1.5 0 0 0</pose><geometry><box><size>0.2 20 3</size></box></geometry></collision>
        <visual name="west_visual"><pose>-15 0 1.5 0 0 0</pose><geometry><box><size>0.2 20 3</size></box></geometry>
          <material><ambient>0.7 0.75 0.8 1</ambient><diffuse>0.7 0.75 0.8 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Overhang: a slab at 2.5 m, only visible through the upper part of the FOV. -->
    <model name="overhang">
      <static>true</static>
      <pose>4 3 2.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>4 4 0.15</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>4 4 0.15</size></box></geometry>
          <material><ambient>0.3 0.5 0.7 1</ambient><diffuse>0.3 0.5 0.7 1</diffuse></material></visual>
      </link>
    </model>
    <model name="overhang_post_a">
      <static>true</static><pose>2.2 1.2 1.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><cylinder><radius>0.1</radius><length>2.5</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.1</radius><length>2.5</length></cylinder></geometry></visual>
      </link>
    </model>
    <model name="overhang_post_b">
      <static>true</static><pose>5.8 4.8 1.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><cylinder><radius>0.1</radius><length>2.5</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.1</radius><length>2.5</length></cylinder></geometry></visual>
      </link>
    </model>

    <model name="pillar_1">
      <static>true</static><pose>-3 2 1.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><cylinder><radius>0.3</radius><length>3</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.3</radius><length>3</length></cylinder></geometry>
          <material><ambient>0.6 0.3 0.3 1</ambient><diffuse>0.6 0.3 0.3 1</diffuse></material></visual>
      </link>
    </model>
    <model name="pillar_2">
      <static>true</static><pose>-6 -4 1.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><cylinder><radius>0.4</radius><length>3</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.4</radius><length>3</length></cylinder></geometry>
          <material><ambient>0.6 0.3 0.3 1</ambient><diffuse>0.6 0.3 0.3 1</diffuse></material></visual>
      </link>
    </model>

    <model name="box_1">
      <static>true</static><pose>3 -3 0.5 0 0 0.4</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>1 1 1</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>1 1 1</size></box></geometry>
          <material><ambient>0.3 0.6 0.3 1</ambient><diffuse>0.3 0.6 0.3 1</diffuse></material></visual>
      </link>
    </model>
    <model name="box_2">
      <static>true</static><pose>-2 -2.5 0.75 0 0 -0.3</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>1.5 0.8 1.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>1.5 0.8 1.5</size></box></geometry>
          <material><ambient>0.3 0.6 0.3 1</ambient><diffuse>0.3 0.6 0.3 1</diffuse></material></visual>
      </link>
    </model>
    <model name="sphere">
      <static>true</static><pose>7 -5 0.8 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><sphere><radius>0.8</radius></sphere></geometry></collision>
        <visual name="v"><geometry><sphere><radius>0.8</radius></sphere></geometry>
          <material><ambient>0.7 0.6 0.2 1</ambient><diffuse>0.7 0.6 0.2 1</diffuse></material></visual>
      </link>
    </model>
    <model name="ramp">
      <static>true</static><pose>-9 5 0.4 0 0.2 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>5 2.5 0.1</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>5 2.5 0.1</size></box></geometry>
          <material><ambient>0.5 0.4 0.6 1</ambient><diffuse>0.5 0.4 0.6 1</diffuse></material></visual>
      </link>
    </model>
  </world>
</sdf>
