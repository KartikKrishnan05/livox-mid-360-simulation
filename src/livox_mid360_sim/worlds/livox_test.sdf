<?xml version="1.0"?>
<!--
  Test world for the Livox Mid-360 simulation.
  Enclosure: inner wall faces at x = +-8.9 m, y = +-6.9 m (2 m high), flat ground z = 0.
  Overhang: slab underside at z = 2.5 m over x 1..4, y -1..1 (the robot fits under it),
  which only the upper part of the +52 deg FOV sees.
-->
<sdf version="1.9">
  <world name="livox_test">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <gravity>0 0 -9.80665</gravity>
    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.7 0.8 0.9 1</background>
      <grid>false</grid>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.4 0.2 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>60 60</size></plane></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>60 60</size></plane></geometry>
          <material>
            <ambient>0.45 0.45 0.42 1</ambient><diffuse>0.55 0.55 0.5 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Enclosure: 4 walls, 0.2 m thick, 2 m high -->
    <model name="wall_north">
      <static>true</static>
      <pose>0 7 1 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>18.2 0.2 2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>18.2 0.2 2</size></box></geometry>
          <material><ambient>0.7 0.6 0.5 1</ambient><diffuse>0.8 0.7 0.6 1</diffuse></material></visual>
      </link>
    </model>
    <model name="wall_south">
      <static>true</static>
      <pose>0 -7 1 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>18.2 0.2 2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>18.2 0.2 2</size></box></geometry>
          <material><ambient>0.7 0.6 0.5 1</ambient><diffuse>0.8 0.7 0.6 1</diffuse></material></visual>
      </link>
    </model>
    <model name="wall_east">
      <static>true</static>
      <pose>9 0 1 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.2 14.2 2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.2 14.2 2</size></box></geometry>
          <material><ambient>0.5 0.6 0.7 1</ambient><diffuse>0.6 0.7 0.8 1</diffuse></material></visual>
      </link>
    </model>
    <model name="wall_west">
      <static>true</static>
      <pose>-9 0 1 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.2 14.2 2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.2 14.2 2</size></box></geometry>
          <material><ambient>0.5 0.6 0.7 1</ambient><diffuse>0.6 0.7 0.8 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Pillars -->
    <model name="pillar_1">
      <static>true</static>
      <pose>4 3.5 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.2</radius><length>3</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.2</radius><length>3</length></cylinder></geometry>
          <material><ambient>0.6 0.2 0.2 1</ambient><diffuse>0.8 0.3 0.3 1</diffuse></material></visual>
      </link>
    </model>
    <model name="pillar_2">
      <static>true</static>
      <pose>-3 -4 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.2</radius><length>3</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.2</radius><length>3</length></cylinder></geometry>
          <material><ambient>0.6 0.2 0.2 1</ambient><diffuse>0.8 0.3 0.3 1</diffuse></material></visual>
      </link>
    </model>
    <model name="pillar_3">
      <static>true</static>
      <pose>-5.5 3 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.3</radius><length>3</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.3</radius><length>3</length></cylinder></geometry>
          <material><ambient>0.6 0.2 0.2 1</ambient><diffuse>0.8 0.3 0.3 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Boxes -->
    <model name="box_1">
      <static>true</static>
      <pose>3 -3 0.5 0 0 0.4</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1 1 1</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1 1 1</size></box></geometry>
          <material><ambient>0.2 0.5 0.2 1</ambient><diffuse>0.3 0.7 0.3 1</diffuse></material></visual>
      </link>
    </model>
    <model name="box_2">
      <static>true</static>
      <pose>-2 2.5 0.75 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.8 0.5 1.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.8 0.5 1.5</size></box></geometry>
          <material><ambient>0.2 0.5 0.2 1</ambient><diffuse>0.3 0.7 0.3 1</diffuse></material></visual>
      </link>
    </model>
    <model name="box_3">
      <static>true</static>
      <pose>6.5 -5 0.3 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.6 0.6 0.6</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.6 0.6 0.6</size></box></geometry>
          <material><ambient>0.2 0.5 0.2 1</ambient><diffuse>0.3 0.7 0.3 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Sphere -->
    <model name="sphere">
      <static>true</static>
      <pose>-4 -1.5 0.6 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><sphere><radius>0.6</radius></sphere></geometry></collision>
        <visual name="visual"><geometry><sphere><radius>0.6</radius></sphere></geometry>
          <material><ambient>0.2 0.2 0.6 1</ambient><diffuse>0.3 0.3 0.8 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Ramp: 3 m long, rises ~0.6 m -->
    <model name="ramp">
      <static>true</static>
      <pose>-1 -5 0.3 0 -0.2 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>3 1.5 0.1</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>3 1.5 0.1</size></box></geometry>
          <material><ambient>0.6 0.5 0.2 1</ambient><diffuse>0.8 0.7 0.3 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Overhang: 3 x 2 m slab, underside at 2.5 m, on four thin posts -->
    <model name="overhang">
      <static>true</static>
      <pose>2.5 0 0 0 0 0</pose>
      <link name="link">
        <collision name="slab_collision">
          <pose>0 0 2.55 0 0 0</pose>
          <geometry><box><size>3 2 0.1</size></box></geometry>
        </collision>
        <visual name="slab_visual">
          <pose>0 0 2.55 0 0 0</pose>
          <geometry><box><size>3 2 0.1</size></box></geometry>
          <material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.65 0.65 0.65 1</diffuse></material>
        </visual>
        <collision name="post_1_collision"><pose>1.45 0.95 1.25 0 0 0</pose><geometry><cylinder><radius>0.04</radius><length>2.5</length></cylinder></geometry></collision>
        <visual name="post_1_visual"><pose>1.45 0.95 1.25 0 0 0</pose><geometry><cylinder><radius>0.04</radius><length>2.5</length></cylinder></geometry></visual>
        <collision name="post_2_collision"><pose>1.45 -0.95 1.25 0 0 0</pose><geometry><cylinder><radius>0.04</radius><length>2.5</length></cylinder></geometry></collision>
        <visual name="post_2_visual"><pose>1.45 -0.95 1.25 0 0 0</pose><geometry><cylinder><radius>0.04</radius><length>2.5</length></cylinder></geometry></visual>
        <collision name="post_3_collision"><pose>-1.45 0.95 1.25 0 0 0</pose><geometry><cylinder><radius>0.04</radius><length>2.5</length></cylinder></geometry></collision>
        <visual name="post_3_visual"><pose>-1.45 0.95 1.25 0 0 0</pose><geometry><cylinder><radius>0.04</radius><length>2.5</length></cylinder></geometry></visual>
        <collision name="post_4_collision"><pose>-1.45 -0.95 1.25 0 0 0</pose><geometry><cylinder><radius>0.04</radius><length>2.5</length></cylinder></geometry></collision>
        <visual name="post_4_visual"><pose>-1.45 -0.95 1.25 0 0 0</pose><geometry><cylinder><radius>0.04</radius><length>2.5</length></cylinder></geometry></visual>
      </link>
    </model>
  </world>
</sdf>
