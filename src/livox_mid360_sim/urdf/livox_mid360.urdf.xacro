<?xml version="1.0"?>
<!--
  Livox Mid-360 (lidar + IMU) as a xacro macro.

  <xacro:include filename="$(find livox_mid360_sim)/urdf/livox_mid360.urdf.xacro"/>
  <xacro:livox_mid360 parent="base_link" xyz="0 0 0.3" rpy="0 0 0" sensor="raycast"/>

  sensor:=raycast  exact CPU ray per pattern direction (approach 2, default, recommended)
  sensor:=gpu      dense gpu_lidar sampled along the pattern (approach 1; needs Sensors/ogre2)
  sensor:=modes    approach 3, one plugin with lidar_mode:=snapshot|sliced|raycast
                     snapshot  1 dense GPU image per frame
                     sliced    ${slices} GPU images per frame, points stamped with their image's time
                     raycast   CPU ray casting against the visual geometry, every ray at its own time

  Frames:  ${frame_id}_base  centre of the mounting face (child of parent at xyz/rpy)
           ${frame_id}       optical centre, 47 mm above the mounting face; points and IMU
                             messages are expressed here (like the real driver).
  The IMU sensor is at (0.011, 0.02329, -0.04412) in ${frame_id}.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="livox_mid360"
    params="parent xyz:='0 0 0' rpy:='0 0 0'
            sensor:=raycast frame_id:=livox_frame
            points_topic:=/livox/points imu_topic:=/livox/imu_raw dense_topic:=/livox/dense_scan
            point_rate:=200000 frame_rate:=10 imu_rate:=200 dense_rate:=50
            geometry_source:=collision
            dense_h_samples:=1440 dense_v_samples:=160
            pattern_file:=model://livox_mid360/scan_mode/mid360.csv
            range_noise:=0.02 min_range:=0.1 max_range:=70.0 nominal_range:=40.0
            lidar_mode:=sliced slices:=5">

    <link name="${frame_id}_base">
      <inertial>
        <origin xyz="0 0 0.03"/>
        <mass value="0.265"/>
        <inertia ixx="1.73e-4" iyy="1.73e-4" izz="1.40e-4" ixy="0" ixz="0" iyz="0"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0.03"/>
        <geometry><cylinder radius="0.0325" length="0.06"/></geometry>
        <material name="livox_black"><color rgba="0.15 0.15 0.15 1"/></material>
      </visual>
      <collision>
        <origin xyz="0 0 0.03"/>
        <geometry><cylinder radius="0.0325" length="0.06"/></geometry>
      </collision>
    </link>
    <joint name="${frame_id}_mount_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="${frame_id}_base"/>
      <origin xyz="${xyz}" rpy="${rpy}"/>
    </joint>

    <link name="${frame_id}">
      <inertial>
        <mass value="0.001"/>
        <inertia ixx="1e-7" iyy="1e-7" izz="1e-7" ixy="0" ixz="0" iyz="0"/>
      </inertial>
    </link>
    <joint name="${frame_id}_joint" type="fixed">
      <parent link="${frame_id}_base"/>
      <child link="${frame_id}"/>
      <origin xyz="0 0 0.047" rpy="0 0 0"/>
    </joint>
    <!-- keep the optical-centre link through URDF->SDF fixed-joint lumping -->
    <gazebo reference="${frame_id}_joint">
      <preserveFixedJoint>true</preserveFixedJoint>
    </gazebo>

    <gazebo reference="${frame_id}">
      <xacro:if value="${sensor == 'modes'}">
        <!-- Rendered frame_rate * slices Hz in sliced mode, frame_rate in snapshot mode. In
             raycast mode it only marks the lidar origin; nothing subscribes, so Gazebo does
             not render it (and it is throttled to 1 Hz in case it does). -->
        <sensor name="${frame_id}_dense_lidar" type="gpu_lidar">
          <pose>0 0 0 0 0 0</pose>
          <topic>${dense_topic}</topic>
          <update_rate>${frame_rate * int(slices) if lidar_mode == 'sliced' else (1 if lidar_mode == 'raycast' else frame_rate)}</update_rate>
          <always_on>true</always_on>
          <visualize>false</visualize>
          <lidar>
            <scan>
              <horizontal>
                <samples>${dense_h_samples}</samples>
                <resolution>1</resolution>
                <min_angle>${-pi}</min_angle>
                <max_angle>${pi}</max_angle>
              </horizontal>
              <vertical>
                <samples>${dense_v_samples}</samples>
                <resolution>1</resolution>
                <min_angle>${radians(-7.5)}</min_angle>
                <max_angle>${radians(52.5)}</max_angle>
              </vertical>
            </scan>
            <range>
              <min>${min_range}</min>
              <max>${max_range}</max>
              <resolution>0.002</resolution>
            </range>
            <xacro:if value="${float(range_noise) > 0}">
              <noise>
                <type>gaussian</type>
                <mean>0.0</mean>
                <stddev>${range_noise}</stddev>
              </noise>
            </xacro:if>
          </lidar>
        </sensor>
      </xacro:if>

      <xacro:if value="${sensor == 'gpu'}">
        <sensor name="${frame_id}_dense" type="gpu_lidar">
          <pose>0 0 0 0 0 0</pose>
          <topic>${dense_topic}</topic>
          <update_rate>${dense_rate}</update_rate>
          <always_on>true</always_on>
          <visualize>false</visualize>
          <lidar>
            <scan>
              <horizontal>
                <samples>${dense_h_samples}</samples>
                <resolution>1</resolution>
                <min_angle>${-pi}</min_angle>
                <max_angle>${pi - 2*pi/dense_h_samples}</max_angle>
              </horizontal>
              <vertical>
                <samples>${dense_v_samples}</samples>
                <resolution>1</resolution>
                <min_angle>${radians(-7.5)}</min_angle>
                <max_angle>${radians(52.5)}</max_angle>
              </vertical>
            </scan>
            <range>
              <min>${min_range}</min>
              <max>${max_range}</max>
              <resolution>0.001</resolution>
            </range>
          </lidar>
        </sensor>
      </xacro:if>

      <sensor name="${frame_id}_imu" type="imu">
        <pose>0.011 0.02329 -0.04412 0 0 0</pose>
        <topic>${imu_topic}</topic>
        <update_rate>${imu_rate}</update_rate>
        <always_on>true</always_on>
        <imu>
          <angular_velocity>
            <x><noise type="gaussian"><mean>0</mean><stddev>6.6e-4</stddev></noise></x>
            <y><noise type="gaussian"><mean>0</mean><stddev>6.6e-4</stddev></noise></y>
            <z><noise type="gaussian"><mean>0</mean><stddev>6.6e-4</stddev></noise></z>
          </angular_velocity>
          <linear_acceleration>
            <x><noise type="gaussian"><mean>0</mean><stddev>0.01</stddev></noise></x>
            <y><noise type="gaussian"><mean>0</mean><stddev>0.01</stddev></noise></y>
            <z><noise type="gaussian"><mean>0</mean><stddev>0.01</stddev></noise></z>
          </linear_acceleration>
        </imu>
      </sensor>
    </gazebo>

    <xacro:if value="${sensor == 'modes'}">
      <gazebo>
        <plugin filename="livox_mid360_modes_system"
                name="livox_mid360_sim::modes::LivoxMid360Modes">
          <input_topic>${dense_topic}</input_topic>
          <output_topic>${points_topic}</output_topic>
          <frame_id>${frame_id}</frame_id>
          <frame_rate>${frame_rate}</frame_rate>
          <points_per_second>${point_rate}</points_per_second>
          <min_range>${min_range}</min_range>
          <max_range>${max_range}</max_range>
          <pattern_file>${pattern_file}</pattern_file>
          <mode>${lidar_mode}</mode>
          <slices>${slices}</slices>
          <sensor_name>${frame_id}_dense_lidar</sensor_name>
          <range_noise>${range_noise}</range_noise>
        </plugin>
      </gazebo>
    </xacro:if>

    <xacro:unless value="${sensor == 'modes'}">
    <gazebo>
      <plugin filename="livox_mid360_sim_system"
              name="livox_mid360_sim::${'LivoxMid360Gpu' if sensor == 'gpu' else 'LivoxMid360Raycast'}">
        <frame_id>${frame_id}</frame_id>
        <link_name>${frame_id}</link_name>
        <dense_topic>${dense_topic}</dense_topic>
        <geometry_source>${geometry_source}</geometry_source>
        <points_topic>${points_topic}</points_topic>
        <pattern_file>${pattern_file}</pattern_file>
        <point_rate>${point_rate}</point_rate>
        <frame_rate>${frame_rate}</frame_rate>
        <min_range>${min_range}</min_range>
        <max_range>${max_range}</max_range>
        <nominal_range>${nominal_range}</nominal_range>
        <range_noise_stddev>${range_noise}</range_noise_stddev>
      </plugin>
    </gazebo>
    </xacro:unless>
  </xacro:macro>
</robot>
