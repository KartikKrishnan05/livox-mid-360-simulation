<?xml version="1.0"?>
<!--
  Livox Mid-360 xacro macro for URDF robots simulated in Gazebo Harmonic.

  Usage:
    <xacro:include filename="$(find livox_mid360_sim)/urdf/livox_mid360.urdf.xacro"/>
    <xacro:livox_mid360 parent="base_link" xyz="0.1 0 0.2"/>

  Creates
    ${frame_id}_base   mounting face of the sensor (child of ${parent})
    ${frame_id}        lidar optical centre; header frame of lidar + IMU (like livox_ros_driver2)

  Gazebo topics (bridge them with ros_gz_bridge):
    ${lidar_topic}  gz.msgs.PointCloudPacked -> sensor_msgs/msg/PointCloud2 (driver layout)
    ${imu_topic}    gz.msgs.IMU              -> sensor_msgs/msg/Imu (m/s^2)
    livox_driver_emulator turns these into /livox/lidar (CustomMsg) + /livox/imu (g).
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="livox_mid360"
    params="parent
            xyz:='0 0 0' rpy:='0 0 0'
            frame_id:=livox_frame
            lidar_topic:=/livox/points
            imu_topic:=/livox/imu_raw
            dense_topic:=/livox/dense_scan
            frame_rate:=10
            points_per_second:=200000
            min_range:=0.1
            max_range:=40.0
            h_samples:=1440
            v_samples:=160
            imu_rate:=200
            pattern_file:=model://livox_mid360/scan_mode/mid360.csv
            mode:=sliced
            slices:=5
            range_noise:=0.02">

    <!-- How the ranges are measured (see src/livox_mid360_system.cpp):
           snapshot  1 dense GPU image per frame
           sliced    ${slices} dense GPU images per frame, points stamped with their image's time
           raycast   CPU ray casting against the visual geometry, every ray at its own time
         In raycast mode the gpu_lidar only marks the lidar origin; nothing subscribes to it,
         so Gazebo does not render it (and it is throttled to 1 Hz in case it does). -->
    <xacro:property name="dense_rate"
      value="${frame_rate * int(slices) if mode == 'sliced' else (1 if mode == 'raycast' else frame_rate)}"/>

    <joint name="${frame_id}_base_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="${frame_id}_base"/>
      <origin xyz="${xyz}" rpy="${rpy}"/>
    </joint>

    <link name="${frame_id}_base">
      <inertial>
        <origin xyz="0 0 0.03"/>
        <mass value="0.265"/>
        <inertia ixx="1.73e-4" ixy="0" ixz="0" iyy="1.73e-4" iyz="0" izz="1.87e-4"/>
      </inertial>
      <collision>
        <origin xyz="0 0 0.03"/>
        <geometry><box size="0.065 0.065 0.06"/></geometry>
      </collision>
      <visual>
        <origin xyz="0 0 0.0175"/>
        <geometry><box size="0.065 0.065 0.035"/></geometry>
        <material name="livox_body"><color rgba="0.2 0.2 0.2 1"/></material>
      </visual>
      <visual>
        <origin xyz="0 0 0.0475"/>
        <geometry><cylinder radius="0.029" length="0.025"/></geometry>
        <material name="livox_window"><color rgba="0.05 0.05 0.1 1"/></material>
      </visual>
    </link>

    <joint name="${frame_id}_joint" type="fixed">
      <parent link="${frame_id}_base"/>
      <child link="${frame_id}"/>
      <origin xyz="0 0 0.047"/>
    </joint>

    <link name="${frame_id}"/>

    <gazebo reference="${frame_id}">
      <sensor name="${frame_id}_dense_lidar" type="gpu_lidar">
        <pose>0 0 0 0 0 0</pose>
        <topic>${dense_topic}</topic>
        <gz_frame_id>${frame_id}</gz_frame_id>
        <update_rate>${dense_rate}</update_rate>
        <always_on>true</always_on>
        <visualize>false</visualize>
        <lidar>
          <scan>
            <horizontal>
              <samples>${h_samples}</samples>
              <resolution>1</resolution>
              <min_angle>${-pi}</min_angle>
              <max_angle>${pi}</max_angle>
            </horizontal>
            <vertical>
              <samples>${v_samples}</samples>
              <resolution>1</resolution>
              <min_angle>${radians(-7.5)}</min_angle>
              <max_angle>${radians(52.5)}</max_angle>
            </vertical>
          </scan>
          <range>
            <min>${min_range}</min>
            <max>70.0</max>
            <resolution>0.002</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.02</stddev>
          </noise>
        </lidar>
      </sensor>

      <!-- Built-in IMU, offset from the optical centre per Livox spec. -->
      <sensor name="${frame_id}_imu" type="imu">
        <pose>0.011 0.02329 -0.04412 0 0 0</pose>
        <topic>${imu_topic}</topic>
        <gz_frame_id>${frame_id}</gz_frame_id>
        <update_rate>${imu_rate}</update_rate>
        <always_on>true</always_on>
        <visualize>false</visualize>
        <imu>
          <angular_velocity>
            <x><noise type="gaussian"><mean>0</mean><stddev>2e-4</stddev><bias_mean>7.5e-6</bias_mean><bias_stddev>8e-7</bias_stddev></noise></x>
            <y><noise type="gaussian"><mean>0</mean><stddev>2e-4</stddev><bias_mean>7.5e-6</bias_mean><bias_stddev>8e-7</bias_stddev></noise></y>
            <z><noise type="gaussian"><mean>0</mean><stddev>2e-4</stddev><bias_mean>7.5e-6</bias_mean><bias_stddev>8e-7</bias_stddev></noise></z>
          </angular_velocity>
          <linear_acceleration>
            <x><noise type="gaussian"><mean>0</mean><stddev>1.7e-2</stddev><bias_mean>0.1</bias_mean><bias_stddev>1e-3</bias_stddev></noise></x>
            <y><noise type="gaussian"><mean>0</mean><stddev>1.7e-2</stddev><bias_mean>0.1</bias_mean><bias_stddev>1e-3</bias_stddev></noise></y>
            <z><noise type="gaussian"><mean>0</mean><stddev>1.7e-2</stddev><bias_mean>0.1</bias_mean><bias_stddev>1e-3</bias_stddev></noise></z>
          </linear_acceleration>
        </imu>
      </sensor>
    </gazebo>

    <gazebo>
      <plugin filename="LivoxMid360System" name="livox_mid360_sim::LivoxMid360System">
        <input_topic>${dense_topic}</input_topic>
        <output_topic>${lidar_topic}</output_topic>
        <frame_id>${frame_id}</frame_id>
        <frame_rate>${frame_rate}</frame_rate>
        <points_per_second>${points_per_second}</points_per_second>
        <min_range>${min_range}</min_range>
        <max_range>${max_range}</max_range>
        <pattern_file>${pattern_file}</pattern_file>
        <mode>${mode}</mode>
        <slices>${slices}</slices>
        <sensor_name>${frame_id}_dense_lidar</sensor_name>
        <range_noise>${range_noise}</range_noise>
      </plugin>
    </gazebo>
  </xacro:macro>
</robot>
