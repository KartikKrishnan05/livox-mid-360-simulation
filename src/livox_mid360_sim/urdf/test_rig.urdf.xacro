<?xml version="1.0"?>
<!--
  Diff-drive test rig with a Livox Mid-360 on a 0.45 m mast.
  base_link is at wheel-axle height (0.1 m above ground).
  livox_frame height above ground = 0.1 + 0.125 + 0.45 + 0.047 = 0.722 m.
  Gazebo topics: /cmd_vel (in), /odom, /tf (odom->base_link), /joint_states.
-->
<robot name="test_rig" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="pattern_file" default="model://livox_mid360/scan_mode/mid360.csv"/>
  <xacro:arg name="dense_rate" default="50"/>
  <xacro:arg name="range_noise" default="0.02"/>
  <xacro:arg name="dense_h" default="1440"/>
  <xacro:arg name="dense_v" default="160"/>

  <xacro:include filename="$(find livox_mid360_sim)/urdf/livox_mid360.urdf.xacro"/>

  <xacro:property name="wheel_r" value="0.1"/>
  <xacro:property name="wheel_sep" value="0.45"/>
  <xacro:property name="mast_len" value="0.45"/>

  <material name="rig_grey"><color rgba="0.6 0.6 0.65 1"/></material>
  <material name="rig_dark"><color rgba="0.2 0.2 0.2 1"/></material>

  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0.05"/>
      <mass value="8.0"/>
      <inertia ixx="0.12" iyy="0.18" izz="0.27" ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.05"/>
      <geometry><box size="0.5 0.4 0.15"/></geometry>
      <material name="rig_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.05"/>
      <geometry><box size="0.5 0.4 0.15"/></geometry>
    </collision>
    <!-- casters (frictionless spheres) -->
    <collision>
      <origin xyz="0.2 0 -0.05"/>
      <geometry><sphere radius="0.05"/></geometry>
    </collision>
    <collision>
      <origin xyz="-0.2 0 -0.05"/>
      <geometry><sphere radius="0.05"/></geometry>
    </collision>
    <visual>
      <origin xyz="0.2 0 -0.05"/>
      <geometry><sphere radius="0.05"/></geometry>
      <material name="rig_dark"/>
    </visual>
    <visual>
      <origin xyz="-0.2 0 -0.05"/>
      <geometry><sphere radius="0.05"/></geometry>
      <material name="rig_dark"/>
    </visual>
  </link>
  <gazebo reference="base_link">
    <mu1>0.0</mu1>
    <mu2>0.0</mu2>
  </gazebo>

  <xacro:macro name="wheel" params="side y">
    <link name="${side}_wheel">
      <inertial>
        <mass value="1.0"/>
        <inertia ixx="0.0028" iyy="0.005" izz="0.0028" ixy="0" ixz="0" iyz="0"/>
      </inertial>
      <visual>
        <origin rpy="${pi/2} 0 0"/>
        <geometry><cylinder radius="${wheel_r}" length="0.05"/></geometry>
        <material name="rig_dark"/>
      </visual>
      <collision>
        <origin rpy="${pi/2} 0 0"/>
        <geometry><cylinder radius="${wheel_r}" length="0.05"/></geometry>
      </collision>
    </link>
    <joint name="${side}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${side}_wheel"/>
      <origin xyz="0 ${y} 0"/>
      <axis xyz="0 1 0"/>
    </joint>
    <gazebo reference="${side}_wheel">
      <mu1>1.0</mu1>
      <mu2>1.0</mu2>
    </gazebo>
  </xacro:macro>
  <xacro:wheel side="left" y="${wheel_sep/2}"/>
  <xacro:wheel side="right" y="${-wheel_sep/2}"/>

  <link name="mast">
    <inertial>
      <origin xyz="0 0 ${mast_len/2}"/>
      <mass value="0.3"/>
      <inertia ixx="0.005" iyy="0.005" izz="0.0001" ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <visual>
      <origin xyz="0 0 ${mast_len/2}"/>
      <geometry><cylinder radius="0.02" length="${mast_len}"/></geometry>
      <material name="rig_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${mast_len/2}"/>
      <geometry><cylinder radius="0.02" length="${mast_len}"/></geometry>
    </collision>
  </link>
  <joint name="mast_joint" type="fixed">
    <parent link="base_link"/>
    <child link="mast"/>
    <origin xyz="0 0 0.125"/>
  </joint>

  <xacro:livox_mid360 parent="mast" xyz="0 0 ${mast_len}" rpy="0 0 0"
                      pattern_file="$(arg pattern_file)" dense_rate="$(arg dense_rate)"
                      range_noise="$(arg range_noise)"
                      dense_h_samples="$(arg dense_h)" dense_v_samples="$(arg dense_v)"/>

  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>${wheel_sep}</wheel_separation>
      <wheel_radius>${wheel_r}</wheel_radius>
      <topic>/cmd_vel</topic>
      <odom_topic>/odom</odom_topic>
      <tf_topic>/tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
      <odom_publish_frequency>50</odom_publish_frequency>
      <max_linear_acceleration>2.0</max_linear_acceleration>
      <min_linear_acceleration>-2.0</min_linear_acceleration>
      <max_angular_acceleration>4.0</max_angular_acceleration>
      <min_angular_acceleration>-4.0</min_angular_acceleration>
    </plugin>
    <!-- ground truth: world pose of base_link (bridged to /ground_truth/pose) -->
    <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
      <publish_link_pose>false</publish_link_pose>
      <publish_model_pose>true</publish_model_pose>
      <publish_nested_model_pose>false</publish_nested_model_pose>
      <use_pose_vector_msg>false</use_pose_vector_msg>
      <update_frequency>1000</update_frequency>
    </plugin>
    <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher">
      <topic>/joint_states</topic>
    </plugin>
  </gazebo>
</robot>
